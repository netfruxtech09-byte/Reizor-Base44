{
  "name": "TicketType",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "description": "Currency code for the ticket price (e.g. USD, INR, EUR)"
    },
    "quantity_total": {
      "type": "number"
    },
    "quantity_sold": {
      "type": "number",
      "default": 0
    },
    "max_per_user": {
      "type": "number",
      "default": 4
    },
    "tier": {
      "type": "string",
      "enum": [
        "early_bird",
        "general",
        "vip",
        "backstage",
        "free_rsvp",
        "hidden"
      ],
      "default": "general"
    },
    "sale_start": {
      "type": "string",
      "format": "date-time"
    },
    "sale_end": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "sold_out",
        "paused",
        "ended"
      ],
      "default": "active"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "show_tickets_left": {
      "type": "boolean",
      "default": false,
      "description": "If true, show remaining ticket count to buyers (subject to threshold)"
    },
    "tickets_left_threshold": {
      "type": "number",
      "description": "Only show remaining count when tickets left <= this number. 0 or empty means always show when show_tickets_left is true."
    }
  },
  "required": [
    "event_id",
    "name",
    "price",
    "quantity_total"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "organizer"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "organizer"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "organizer"
          }
        }
      ]
    }
  }
}