{
  "name": "ArtistClickTracking",
  "type": "object",
  "properties": {
    "artist_name": {
      "type": "string"
    },
    "artist_id": {
      "type": "string"
    },
    "is_on_platform": {
      "type": "boolean",
      "default": false
    },
    "event_id": {
      "type": "string"
    },
    "event_title": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "lineup_click",
        "search"
      ],
      "default": "lineup_click"
    }
  },
  "required": [
    "artist_name"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}