{
  "name": "VideoBudget",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "description": "User ID of the owner"
    },
    "owner_email": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "owner_type": {
      "type": "string",
      "enum": [
        "organizer",
        "artist",
        "admin"
      ],
      "description": "Type of the owner"
    },
    "video_url": {
      "type": "string",
      "description": "CDN URL of the video file"
    },
    "video_title": {
      "type": "string"
    },
    "file_size_bytes": {
      "type": "number",
      "description": "Video file size in bytes"
    },
    "context_type": {
      "type": "string",
      "enum": [
        "organizer_media",
        "artist_gallery",
        "event_video",
        "community_post",
        "video_360",
        "other"
      ],
      "default": "other"
    },
    "context_id": {
      "type": "string",
      "description": "ID of the parent record (album ID, event ID, post ID, etc.)"
    },
    "budget_amount": {
      "type": "number",
      "default": 0,
      "description": "Total funded budget in USD"
    },
    "used_amount": {
      "type": "number",
      "default": 0,
      "description": "Estimated usage in USD"
    },
    "remaining_amount": {
      "type": "number",
      "default": 0,
      "description": "budget_amount - used_amount"
    },
    "estimated_view_count": {
      "type": "number",
      "default": 0
    },
    "estimated_gb_used": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "no_budget",
        "legacy"
      ],
      "default": "no_budget",
      "description": "active = funded and under cap, paused = cap reached, no_budget = not yet funded, legacy = pre-budget video"
    },
    "enforcement_enabled": {
      "type": "boolean",
      "default": false,
      "description": "If false, video plays regardless of budget (legacy/grace mode)"
    },
    "stripe_payment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "All Stripe PaymentIntent IDs that funded this budget"
    },
    "last_funded_at": {
      "type": "string",
      "format": "date-time"
    },
    "paused_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "owner_user_id",
    "video_url"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}