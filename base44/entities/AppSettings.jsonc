{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "setting_key": {
      "type": "string",
      "description": "Unique key identifier for this setting"
    },
    "setting_value": {
      "type": "string",
      "description": "Value for this setting (string/boolean/number as string)"
    },
    "label": {
      "type": "string",
      "description": "Human-readable label for the setting"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "description": "Category grouping for settings UI"
    }
  },
  "required": [
    "setting_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}