{
  "name": "TwoFactorOTP",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "otp_hash": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "used": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_email",
    "otp_hash",
    "expires_at"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}