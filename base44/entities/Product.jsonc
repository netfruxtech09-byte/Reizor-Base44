{
  "name": "Product",
  "type": "object",
  "properties": {
    "artist_id": {
      "type": "string"
    },
    "artist_name": {
      "type": "string"
    },
    "artist_email": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "clothing",
        "accessories",
        "music",
        "prints",
        "other"
      ],
      "default": "other"
    },
    "sizes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stock": {
      "type": "number",
      "default": 0
    },
    "shipping_price": {
      "type": "number",
      "default": 0
    },
    "free_shipping_for_tiers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "artist_id",
    "name",
    "price"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}