{
  "name": "Expense",
  "type": "object",
  "properties": {
    "holder_type": {
      "type": "string",
      "enum": [
        "platform",
        "organizer",
        "artist",
        "white_label"
      ],
      "default": "platform",
      "description": "Type of holder: platform (admin), organizer, artist, or white label"
    },
    "holder_id": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "description": "ID of the holder. Optional for platform, required for other types."
    },
    "holder_name": {
      "type": "string",
      "description": "Name of the holder for display"
    },
    "event_id": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "description": "Optional: ID of related event"
    },
    "event_title": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "description": "Optional: Title of related event"
    },
    "expense_name": {
      "type": "string",
      "description": "Name/description of the expense"
    },
    "amount": {
      "type": "number",
      "description": "Expense amount in dollars"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "description": "Optional internal notes"
    },
    "category": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "description": "Optional free-text expense category"
    },
    "expense_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "default": null,
      "description": "Date the expense occurred"
    }
  },
  "required": [
    "holder_type",
    "holder_name",
    "expense_name",
    "amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "organizer"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}