{
  "name": "OrganizerFinancialLabel",
  "type": "object",
  "properties": {
    "organizer_id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "label_type": {
      "type": "string",
      "enum": [
        "expense",
        "income",
        "general_expense"
      ]
    },
    "amount": {
      "type": "number"
    }
  },
  "required": [
    "organizer_id",
    "label",
    "label_type"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}