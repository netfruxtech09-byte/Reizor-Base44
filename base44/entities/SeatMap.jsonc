{
  "name": "SeatMap",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_title": {
      "type": "string"
    },
    "canvas_width": {
      "type": "number",
      "default": 800
    },
    "canvas_height": {
      "type": "number",
      "default": 600
    },
    "stage_label": {
      "type": "string",
      "default": "STAGE"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "rows": {
            "type": "number"
          },
          "cols": {
            "type": "number"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "color": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "tier_name": {
            "type": "string"
          },
          "proximity": {
            "type": "string"
          }
        }
      }
    },
    "taken_seats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "event_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "organizer"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "organizer"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "organizer"
          }
        }
      ]
    }
  }
}