{
  "name": "EventRaffleSetup",
  "type": "object",
  "description": "Raffle configuration for an event. Users enter a pool and winners are selected randomly after the raffle closes.",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_title": {
      "type": "string"
    },
    "organizer_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "Raffle title"
    },
    "prize_name": {
      "type": "string",
      "description": "Prize/reward name"
    },
    "prize_description": {
      "type": "string"
    },
    "num_winners": {
      "type": "number",
      "default": 1,
      "description": "Number of winners to be randomly selected"
    },
    "eligibility_action": {
      "type": "string",
      "enum": [
        "ticket_purchase",
        "repost_share",
        "follow_organizer",
        "other"
      ],
      "default": "ticket_purchase"
    },
    "eligibility_notes": {
      "type": "string",
      "description": "Custom eligibility rules/instructions"
    },
    "prize_collection_instructions": {
      "type": "string"
    },
    "start_datetime": {
      "type": "string",
      "format": "date-time"
    },
    "close_datetime": {
      "type": "string",
      "format": "date-time",
      "description": "When raffle entries close"
    },
    "draw_datetime": {
      "type": "string",
      "format": "date-time",
      "description": "When winners are selected"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "active",
        "closed",
        "drawn",
        "cancelled"
      ],
      "default": "upcoming"
    },
    "total_entries": {
      "type": "number",
      "default": 0
    },
    "winner_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "winner_emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "winner_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "drawn_at": {
      "type": "string",
      "format": "date-time"
    },
    "drawn_by_email": {
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "organizer_id",
    "title",
    "prize_name",
    "num_winners"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}