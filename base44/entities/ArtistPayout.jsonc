{
  "name": "ArtistPayout",
  "type": "object",
  "properties": {
    "artist_id": {
      "type": "string"
    },
    "artist_name": {
      "type": "string"
    },
    "artist_email": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "bank_account_name": {
      "type": "string"
    },
    "bank_account_number": {
      "type": "string"
    },
    "bank_routing_number": {
      "type": "string"
    },
    "bank_name": {
      "type": "string"
    },
    "paypal_email": {
      "type": "string"
    },
    "payout_method": {
      "type": "string",
      "enum": [
        "bank_transfer",
        "paypal"
      ],
      "default": "bank_transfer"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "rejected"
      ],
      "default": "pending"
    },
    "admin_note": {
      "type": "string"
    },
    "stripe_transfer_id": {
      "type": "string"
    },
    "processed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "artist_id",
    "artist_email",
    "amount",
    "payout_method"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.artist_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}