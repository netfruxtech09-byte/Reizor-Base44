{
  "name": "SellerLink",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_title": {
      "type": "string"
    },
    "organizer_id": {
      "type": "string"
    },
    "organizer_email": {
      "type": "string"
    },
    "promoter_name": {
      "type": "string"
    },
    "promoter_email": {
      "type": "string"
    },
    "promoter_phone": {
      "type": "string"
    },
    "tracking_code": {
      "type": "string",
      "description": "Unique code used in URL e.g. ?seller=CODE"
    },
    "max_tickets": {
      "type": "number",
      "default": 0,
      "description": "0 = unlimited"
    },
    "max_tables": {
      "type": "number",
      "default": 0,
      "description": "0 = unlimited"
    },
    "tickets_sold": {
      "type": "number",
      "default": 0
    },
    "tables_sold": {
      "type": "number",
      "default": 0
    },
    "total_revenue": {
      "type": "number",
      "default": 0
    },
    "commission_type": {
      "type": "string",
      "enum": [
        "none",
        "fixed",
        "percentage"
      ],
      "default": "none"
    },
    "commission_value": {
      "type": "number",
      "default": 0
    },
    "commission_earned": {
      "type": "number",
      "default": 0
    },
    "custom_ticket_price": {
      "type": "number",
      "description": "Override ticket price (0 = use event price)"
    },
    "custom_table_price": {
      "type": "number",
      "description": "Override table price (0 = use event price)"
    },
    "start_date": {
      "type": "string",
      "format": "date-time"
    },
    "expiry_date": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "last_sale_date": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "promoter_name",
    "tracking_code"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "organizer"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "organizer"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "organizer"
          }
        }
      ]
    }
  }
}