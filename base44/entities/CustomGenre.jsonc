{
  "name": "CustomGenre",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name of the custom genre"
    },
    "key": {
      "type": "string",
      "description": "Lowercase key used as value (e.g. 'my_genre')"
    }
  },
  "required": [
    "name",
    "key"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}