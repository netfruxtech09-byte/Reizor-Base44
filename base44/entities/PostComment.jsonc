{
  "name": "PostComment",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string",
      "description": "ID of the OrganizerMediaPost this comment belongs to"
    },
    "organizer_id": {
      "type": "string",
      "description": "ID of the organizer who owns the post"
    },
    "fan_email": {
      "type": "string",
      "description": "Email of the fan who wrote the comment"
    },
    "fan_name": {
      "type": "string",
      "description": "Display name of the fan"
    },
    "comment_text": {
      "type": "string",
      "description": "The comment content"
    },
    "parent_comment_id": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "description": "If this is a reply, the ID of the parent comment"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "hidden"
      ],
      "default": "active",
      "description": "Visibility status. Hidden = removed by organizer/admin"
    }
  },
  "required": [
    "post_id",
    "organizer_id",
    "fan_email",
    "fan_name",
    "comment_text"
  ],
  "rls": {
    "create": {
      "data.fan_email": "{{user.email}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.fan_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.organizer_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.fan_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.organizer_id": "{{user.id}}"
        }
      ]
    }
  }
}