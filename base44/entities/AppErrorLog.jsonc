{
  "name": "AppErrorLog",
  "type": "object",
  "properties": {
    "error_message": {
      "type": "string"
    },
    "error_stack": {
      "type": "string"
    },
    "error_type": {
      "type": "string",
      "enum": [
        "api_error",
        "payment_error",
        "streaming_error",
        "storage_error",
        "auth_error",
        "upload_error",
        "billing_error"
      ],
      "default": "api_error"
    },
    "route_url": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "user_role": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "ios",
        "android",
        "web"
      ],
      "default": "web"
    },
    "user_agent": {
      "type": "string"
    },
    "extra_context": {
      "type": "string"
    }
  },
  "required": [
    "error_message"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}