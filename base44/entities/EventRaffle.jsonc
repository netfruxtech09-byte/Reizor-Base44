{
  "name": "EventRaffle",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Optional: linked event ID. Empty for standalone raffles."
    },
    "event_title": {
      "type": "string"
    },
    "organizer_id": {
      "type": "string"
    },
    "organizer_name": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Raffle name/title"
    },
    "description": {
      "type": "string"
    },
    "prize_description": {
      "type": "string"
    },
    "entry_fee_type": {
      "type": "string",
      "enum": [
        "free",
        "paid"
      ],
      "default": "free"
    },
    "entry_fee_amount": {
      "type": "number",
      "default": 0
    },
    "max_entries_per_user": {
      "type": "number",
      "default": 1
    },
    "num_winners": {
      "type": "number",
      "default": 1
    },
    "winner_selection": {
      "type": "string",
      "enum": [
        "random",
        "manual"
      ],
      "default": "random"
    },
    "start_datetime": {
      "type": "string",
      "format": "date-time"
    },
    "end_datetime": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "active",
        "ended",
        "drawn",
        "cancelled"
      ],
      "default": "upcoming"
    },
    "total_entries": {
      "type": "number",
      "default": 0
    },
    "winner_emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "winner_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "drawn_at": {
      "type": "string",
      "format": "date-time"
    },
    "credit_amount": {
      "type": "number",
      "default": 0
    },
    "created_by_admin": {
      "type": "boolean",
      "default": false
    },
    "is_standalone": {
      "type": "boolean",
      "default": false,
      "description": "True if not linked to any event"
    },
    "notified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When follower notifications were sent. Prevents duplicate sends."
    }
  },
  "required": [
    "name",
    "organizer_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "organizer"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "organizer"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "organizer"
          }
        }
      ]
    }
  }
}