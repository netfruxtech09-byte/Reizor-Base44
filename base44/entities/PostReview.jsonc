{
  "name": "PostReview",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string",
      "description": "ID of the OrganizerMediaPost being reviewed"
    },
    "organizer_id": {
      "type": "string",
      "description": "ID of the organizer who owns the post"
    },
    "fan_email": {
      "type": "string",
      "description": "Email of the fan leaving the review"
    },
    "fan_name": {
      "type": "string",
      "description": "Display name of the fan"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Star rating from 1 to 5"
    },
    "review_text": {
      "type": "string",
      "description": "The review content"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "hidden"
      ],
      "default": "active",
      "description": "Visibility status. Hidden = removed by organizer/admin"
    }
  },
  "required": [
    "post_id",
    "organizer_id",
    "fan_email",
    "fan_name",
    "rating"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "$or": [
        {
          "data.fan_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.organizer_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.fan_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.organizer_id": "{{user.id}}"
        }
      ]
    }
  }
}