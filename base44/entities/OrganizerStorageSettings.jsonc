{
  "name": "OrganizerStorageSettings",
  "type": "object",
  "properties": {
    "organizer_id": {
      "type": "string",
      "description": "If set, overrides global defaults for this organizer specifically"
    },
    "free_gb_per_month": {
      "type": "number",
      "default": 10,
      "description": "Free GB allowance per month (default: 10)"
    },
    "charge_per_gb": {
      "type": "number",
      "default": 0.1,
      "description": "USD charged per extra GB per month (default: $0.10)"
    },
    "is_global": {
      "type": "boolean",
      "default": false,
      "description": "If true, this is the global default setting"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}