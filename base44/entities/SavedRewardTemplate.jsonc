{
  "name": "SavedRewardTemplate",
  "type": "object",
  "description": "Organizer-private saved reward templates for reuse across giveaways.",
  "properties": {
    "organizer_id": {
      "type": "string"
    },
    "organizer_email": {
      "type": "string"
    },
    "reward_name": {
      "type": "string"
    },
    "reward_description": {
      "type": "string"
    },
    "redemption_instructions": {
      "type": "string"
    },
    "reward_value": {
      "type": "number",
      "description": "Optional monetary value of the reward"
    }
  },
  "required": [
    "organizer_id",
    "reward_name"
  ],
  "rls": {
    "create": {
      "data.organizer_id": "{{user.id}}"
    },
    "read": {
      "data.organizer_id": "{{user.id}}"
    },
    "update": {
      "data.organizer_id": "{{user.id}}"
    },
    "delete": {
      "data.organizer_id": "{{user.id}}"
    }
  }
}