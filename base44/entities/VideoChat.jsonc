{
  "name": "VideoChat",
  "type": "object",
  "properties": {
    "artist_id": {
      "type": "string"
    },
    "artist_name": {
      "type": "string"
    },
    "artist_email": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "allowed_tier_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_tier_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "room_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "live",
        "ended"
      ],
      "default": "scheduled"
    }
  },
  "required": [
    "artist_id",
    "title",
    "room_id"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "$or": [
        {
          "data.artist_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.artist_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}