{
  "name": "ArtistFollow",
  "type": "object",
  "properties": {
    "artist_id": {
      "type": "string"
    },
    "artist_name": {
      "type": "string"
    },
    "follower_email": {
      "type": "string"
    },
    "follower_name": {
      "type": "string"
    }
  },
  "required": [
    "artist_id",
    "follower_email"
  ],
  "rls": {
    "create": {
      "data.follower_email": "{{user.email}}"
    },
    "read": {},
    "update": {
      "data.follower_email": "{{user.email}}"
    },
    "delete": {
      "$or": [
        {
          "data.follower_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}